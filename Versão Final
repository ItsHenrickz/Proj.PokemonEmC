#include <stdio.h>
#include <stdlib.h>
#include <time.h>

//Estrutura para definir as características do pokémon.
struct Pokemon{
    int indice;
    char nome[50];
    int vida;
    int danobase;
    void (*ataque1)(struct Pokemon*, struct Pokemon*);
    void (*ataque2)(struct Pokemon*, struct Pokemon*);
    void (*ataque3)(struct Pokemon*, struct Pokemon*);
    void (*ataque4)(struct Pokemon*, struct Pokemon*);
    int velocidade;
    char nomeatk1[50];
    char nomeatk2[50];
    char nomeatk3[50];
    char nomeatk4[50];
};

//Array para armazenar os pokémons já existentes.
struct Pokemon pokemons[4];

//Função para copiar a string do nome do pokemon para a variavel nome do tipo Pokemon.
void copiaNome(char destinoNome[], const char origemNome[]){
    int i = 0;
    while (origemNome[i] != '\0'){
        destinoNome[i] = origemNome[i];
        i++;
    }
    destinoNome[i] = '\0';
}

//Fórmula para calcular o dano de um ataque.
int formAtk(struct Pokemon *primeiro, int poderAtk){
    return (primeiro->danobase * poderAtk)/50;
}

//Ataques: Cada ataque possui sua própria função.
//Ataques do Gengar
void ShadowBall(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 60); //Inimigo
    printf("%s usou Shadow Ball! ", primeiro->nome);
}
void Confusion(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 30); //Inimigo
    segundo->velocidade *= 0.8; //Inimigo
    printf("%s usou Confusion! A velocidade do inimigo diminuiu! ", primeiro->nome);
}
void Growth(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->danobase *= 1.2; //Usuário
    printf("%s usou Growth! O dano base do usuário aumentou!\n", primeiro->nome);
}
void NightShade(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 45); //Inimigo
    printf("%s usou Night Shade! ", primeiro->nome);
}

//Ataques do Lucario
void AuraSphere(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 80); //Inimigo
    printf("%s usou Aura Sphere! ", primeiro->nome);
}
void BulkUp(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->danobase *= 1.2; //Usuário
    printf("%s usou Bulk Up! O dano base do usuário aumentou!\n", primeiro->nome);
}
void CloseCombat (struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 100); //Inimigo
    primeiro->vida -= 20; //Usuário
    printf("%s usou Close Combat! %s perdeu um pouco de vida! ", primeiro->nome, primeiro->nome);
}
void HealPulse(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->vida += 40; //Usuário
    if (primeiro->vida > 220){
        primeiro->vida = 220;
    }
    printf("%s usou Heal Pulse! %s recuperou um pouco de vida!\n", primeiro->nome, primeiro->nome);
}

//Ataques do Scizor
void BulletPunch(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 50);
    primeiro->velocidade *= 1.3;
    printf("%s usou Bullet Punch! Sua velocidade aumentou! ", primeiro->nome);
}

void SwordsDance(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->danobase *= 1.5;
    printf("%s usou Swords Dance! Seu poder de ataque aumentou consideravelmente!\n", primeiro->nome);
}

void IronHead(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 70);
    printf("%s usou Iron Head! ", primeiro->nome);
}

void XScissor(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 65);
    printf("%s usou X-Scissor! ", primeiro->nome);
}

//Ataques do Greninja
void WaterShuriken(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 50);
    printf("%s usou Water Shuriken! ", primeiro->nome);
}

void DarkPulse(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 60);
    printf("%s usou Dark Pulse! ", primeiro->nome);
}

void DoubleTeam(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->velocidade *= 1.3;
    printf("%s usou Double Team! Sua velocidade aumentou!\n", primeiro->nome);
}

void HydroPump(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 90);
    printf("%s usou Hydro Pump! ", primeiro->nome);
}


//Função que permite adicionar os pokemons e suas características no array "pokemons[]".
void criarPokemon(
    int indice,
    const char *nome,
    int vida,
    int danobase,
    int velocidade,
    void (*ataq1)(struct Pokemon*, struct Pokemon*), const char *nome1,
    void (*ataq2)(struct Pokemon*, struct Pokemon*), const char *nome2,
    void (*ataq3)(struct Pokemon*, struct Pokemon*), const char *nome3,
    void (*ataq4)(struct Pokemon*, struct Pokemon*), const char *nome4
    ){
        pokemons[indice].indice = indice;
        copiaNome(pokemons[indice].nome, nome);
        pokemons[indice].vida = vida;
        pokemons[indice].danobase = danobase;
        pokemons[indice].ataque1 = ataq1;
        pokemons[indice].ataque2 = ataq2;
        pokemons[indice].ataque3 = ataq3;
        pokemons[indice].ataque4 = ataq4;
        pokemons[indice].velocidade = velocidade;
        copiaNome(pokemons[indice].nomeatk1, nome1);
        copiaNome(pokemons[indice].nomeatk2, nome2);
        copiaNome(pokemons[indice].nomeatk3, nome3);
        copiaNome(pokemons[indice].nomeatk4, nome4);
    }
    
//Função que adiciona cada pokemon no array.
void colocarPokemons(){
    
    criarPokemon(
        0, "Gengar", 200, 50, 100, ShadowBall, "Shadow Ball", Confusion, "Confusion", Growth, "Growth",
        NightShade,"Night Shade"
        );
    
    criarPokemon(
        1, "Lucario", 220, 45, 90, AuraSphere, "Aura Sphere", BulkUp, "Bulk Up", CloseCombat, "Close Combat",
