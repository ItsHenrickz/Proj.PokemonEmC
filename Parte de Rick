void calcularBatalha(struct Pokemon *p1, struct Pokemon *p2, int atk1, int atk2) {
    struct Pokemon *primeiro, *segundo;
    int atkPrimeiro, atkSegundo;

    if (p1->velocidade >= p2->velocidade) {
        primeiro = p1;
        segundo = p2;
        atkPrimeiro = atk1;
        atkSegundo = atk2;
    } else {
        primeiro = p2;
        segundo = p1;
        atkPrimeiro = atk2;
        atkSegundo = atk1;
    }

    printf("\n%s é mais rápido e vai atacar primeiro!\n", primeiro->nome);

    if (atkPrimeiro == 1) {
        primeiro->ataque1(primeiro, segundo);
    } else if (atkPrimeiro == 2) {
        primeiro->ataque2(primeiro, segundo);
    } else if (atkPrimeiro == 3) {
        primeiro->ataque3(primeiro, segundo);
    } else if (atkPrimeiro == 4) {
        primeiro->ataque4(primeiro, segundo);
    }

    if (segundo->vida <= 0) {
        printf("\n%s foi derrotado!\n", segundo->nome);
        return;
    }

    if (atkSegundo == 1) {
        segundo->ataque1(segundo, primeiro);
    } else if (atkSegundo == 2) {
        segundo->ataque2(segundo, primeiro);
    } else if (atkSegundo == 3) {
        segundo->ataque3(segundo, primeiro);
    } else if (atkSegundo == 4) {
        segundo->ataque4(segundo, primeiro);
    }

    if (p1->vida < 0) p1->vida = 0;
    if (p2->vida < 0) p2->vida = 0;

    printf("\n--- STATUS ATUAL ---\n");
    printf("%s - Vida: %d | Velocidade: %d\n", p1->nome, p1->vida, p1->velocidade);
    printf("%s - Vida: %d | Velocidade: %d\n", p2->nome, p2->vida, p2->velocidade);
}

