#include <stdio.h>

//Estrutura para definir as características do pokémon.
struct Pokemon{
    int indice;
    char nome[50];
    int vida;
    int danobase;
    void (*ataque1)(struct Pokemon*, struct Pokemon*); 
    void (*ataque2)(struct Pokemon*, struct Pokemon*); 
    void (*ataque3)(struct Pokemon*, struct Pokemon*); 
    void (*ataque4)(struct Pokemon*, struct Pokemon*); 
    int velocidade;
};

//Array para armazenar os pokémons já existentes.
struct Pokemon pokemons[4];

//Função para copiar a string do nome do pokemon para a variavel nome do tipo Pokemon.
void copiaNome(char destinoNome[], const char origemNome[]){
    int i = 0;
    while (origemNome[i] != '\0'){
        destinoNome[i] = origemNome[i];
        i++;
    }
    destinoNome[i] = '\0';
}

int x;

void ShadowBall(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= 60; //Inimigo
    printf("%s usou Shadow Ball! Vida atual do Inimigo: %d\n", primeiro->nome, segundo->vida);
}
void Confusion(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= 30; //Inimigo
    segundo->velocidade *= 0.8; //Inimigo
    printf("%s usou Confusion! A velocidade do inimigo diminuiu! Vida atual do inimigo: %d\n", primeiro->nome, segundo->vida);
}
void Growth(struct Pokemon *primeiro, struct Pokemon *segundo){
    primeiro->danobase *= 1.2; //Usuário
    printf("%s usou Growth! O dano base do usuário aumentou!", primeiro->nome);
}
void NightShade(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= 45; //Inimigo
    printf("%s usou Night Shade! Vida atual do inimigo: %d\n", primeiro->nome, segundo->vida);
}
void AuraSphere(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= 80; //Inimigo
    printf("%s usou Aura Sphere! Vida atual do Inimigo: %d\n", primeiro->nome, segundo->vida);
}


