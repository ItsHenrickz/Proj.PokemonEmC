    int vida;
    int danobase;
    int ataque1; 
    int ataque2; 
    int ataque3; 
    int ataque4;
    int velocidade;
};

//Array para armazenar os pokémons já existentes.
struct Pokemon pokemons[4];

//Função para copiar a string do nome do pokemon para a variavel nome do tipo Pokemon.
void copiaNome(char destinoNome[], const char origemNome[]){
    int i = 0;
    while (origemNome[i] != '\0'){
        destinoNome[i] = origemNome[i];
        i++;
    }
    destinoNome[i] = '\0';
}

