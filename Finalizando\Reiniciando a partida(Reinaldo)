void calcularBatalha(struct Pokemon *p1, struct Pokemon *p2, int atk1, int atk2) {
    
    // O loop continua enquanto ambos os Pokémons estiverem vivos
    while (p1->vida > 0 && p2->vida > 0) {
        
        printf("\n================ NOVO TURNO ================\n");
        
        struct Pokemon *primeiro, *segundo;
        int atkPrimeiro, atkSegundo;
        
        // Determina quem ataca primeiro com base na velocidade
        if (p1->velocidade >= p2->velocidade) {
            primeiro = p1;
            segundo = p2;
            atkPrimeiro = atk1;
            atkSegundo = atk2;
        } else {
            primeiro = p2;
            segundo = p1;
            atkPrimeiro = atk2;
            atkSegundo = atk1;
        }
        
        printf("\n%s é mais rápido e vai atacar primeiro!\n", primeiro->nome);
        
        // Ataque do Pokémon 1 (o mais rápido)
        if (atkPrimeiro == 1) {
            primeiro->ataque1(primeiro, segundo);
        } else if (atkPrimeiro == 2) {
            primeiro->ataque2(primeiro, segundo);
        } else if (atkPrimeiro == 3) {
            primeiro->ataque3(primeiro, segundo);
        } else if (atkPrimeiro == 4) {
            primeiro->ataque4(primeiro, segundo);
        }
        
        // Verifica a morte após o primeiro ataque
        if (segundo->vida <= 0) {
            segundo->vida = 0; // Garante que a vida não seja negativa
            break; // Sai do loop, o Pokémon 1 venceu
        }
        
        // Ataque do Pokémon 2 (se ainda estiver vivo)
        printf("\n--- Contra-ataque ---\n");
        if (atkSegundo == 1) {
            segundo->ataque1(segundo, primeiro);
        } else if (atkSegundo == 2) {
            segundo->ataque2(segundo, primeiro);
        } else if (atkSegundo == 3) {
            segundo->ataque3(segundo, primeiro);
        } else if (atkSegundo == 4) {
            segundo->ataque4(segundo, primeiro);
        }
        
        // Verifica a morte após o segundo ataque
        if (primeiro->vida <= 0) {
            primeiro->vida = 0; // Garante que a vida não seja negativa
            break; // Sai do loop, o Pokémon 2 venceu
        }
        
        printf("\n--- STATUS FIM DO TURNO ---\n");
        printf("%s - Vida: %d | Velocidade: %d\n", p1->nome, p1->vida, p1->velocidade);
        printf("%s - Vida: %d | Velocidade: %d\n", p2->nome, p2->vida, p2->velocidade);
    }
}
    
int main()
{
    colocarPokemons();
    
    int escolha = 1;
    
    do {
        struct Pokemon p1 = pokemons[0];
        struct Pokemon p2 = pokemons[1];
        
        calcularBatalha(&p1, &p2, 1, 1);
        
        if (p1.vida == 0) {
            printf("\nCom a morte de %s, o jogador 1 acabou perdendo, assim: === VENCE a partida o JOGADOR 2 (Utilizando %s) ===\n", p1.nome, p2.nome);
        }else if (p2.vida == 0) {
            printf("\nCom a morte de %s, o jogador 2 acabou perdendo a partida, assim: === VENCE a partida o JOGADOR 1 (Utilizando %s) ===\n", p2.nome, p1.nome);
        }
        
        printf("\nClique:\n1)Jogar novamente\nQualquer outra tecla)Finalizar o jogo\n");
        
        if (scanf("%d", &escolha) !=1) {
            escolha = 2;
            while (getchar() != '\n');
        }
        
    }while (escolha == 1);
    
    printf("\nPrograma encerrado.\n");
    
    return 0;
}
