//Ataques do Greninja
void WaterShuriken(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 50);
    printf("%s usou Water Shuriken! Vida atual do inimigo: %d\n", primeiro->nome, segundo->vida);
