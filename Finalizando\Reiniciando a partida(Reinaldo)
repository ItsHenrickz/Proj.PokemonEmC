void IronHead(struct Pokemon *primeiro, struct Pokemon *segundo){
    segundo->vida -= formAtk(primeiro, 70);
    printf("%s usou Iron Head! Vida atual do inimigo: %d\n", primeiro->nome, segundo->vida);
